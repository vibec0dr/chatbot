{
  "name": "meilisearch-cleanup",
  "entry": "./dist/index.js",
  "bundle": {
    "enabled": true,
    "out": "./build/meili-cleanup.js",
    "format": "esm",
    "target": "node24",
    "external": []
  },
  "native": {
    "enabled": true,
    "targets": ["linux-x64", "linux-arm64"],
    "binaryName": "meili-cleanup",
    "stripSourceMaps": true
  },
  "assets": [
    "README.md",
    "./dist/**/*"
  ],
  "docker": {
    "imagePath": "/usr/local/bin/meili-cleanup",
    "copyFrom": "./build/meili-cleanup.js",
    "chmod": "+x"
  }
}
