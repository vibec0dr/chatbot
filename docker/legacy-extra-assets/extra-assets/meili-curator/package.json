{
  "name": "@image-extras/meili-curator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Meilisearch curator CLI — prunes stale documents from an index",
  "bin": {
    "meili-curator": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:bundle": "node ./scripts/package-standalone.mjs bundle",
    "dev": "tsc -w -p tsconfig.json",
    "start": "node ./dist/index.js",
    "test": "node --test --test-reporter=spec"
  },
  "dependencies": {
    "mongodb": "^5.9.0"
  },
  "devDependencies": {
    "typescript": "^5.5.2",
    "@types/node": "^20.9.1",
    "esbuild": "^0.18.18"
  }
}
