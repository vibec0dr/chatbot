{
  "name": "secret-service",
  "entry": "./dist/index.js",
  "bundle": {
    "enabled": true,
    "out": "./build/secret-service.js",
    "format": "esm",
    "target": "node24",
    "external": []
  },
  "assets": ["README.md","./dist/**/*"],
  "docker": {
    "imagePath": "/usr/local/bin/secret-service",
    "copyFrom": "./build/secret-service.js",
    "chmod": "+x"
  }
}
